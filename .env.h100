# H100 server settings. Copy to `.env` on that machine (docs/RUNBOOK.md step 3):
#
#     cp .env.h100 .env
#
# docker compose reads `.env` automatically, so after that copy every
# `docker compose ...` command in the docs picks up both the overlay and these
# variables with no extra flags. `.env` is gitignored; this template is not.
#
# Do NOT copy this on the laptop -- COMPOSE_FILE would pull in server-sized
# memory limits that the laptop cannot honour.

# Layer the H100 overlay on top of the base compose file. ":" is the separator
# on Linux and macOS (COMPOSE_PATH_SEPARATOR); on Windows it is ";".
COMPOSE_FILE=docker-compose.yml:docker-compose.h100.yml

# Where vLLM is listening. host.docker.internal is the H100 host itself, from
# inside the container -- resolved by the extra_hosts line in the overlay.
LAB_LLM_URL=http://host.docker.internal:8000/v1

# Must match the --api-key you pass to `vllm serve`. vLLM requires one even
# on localhost; it is not a secret, just a matched string.
LAB_LLM_TOKEN=local-sweep

# Must match `vllm serve --served-model-name`. If you drop that flag, vLLM
# serves the full HuggingFace repo id instead and this has to match THAT.
#
# qwen2.5-coder-14b, not the qwen3-coder-30b originally chosen in
# SLM_SELECTION.md -- the H100 turned out to have a standing tenant using
# ~60GB, leaving too little free for the 30B model's ~31GB FP8 footprint.
# See Blocker 12 in docs/IMPLEMENTATION.md.
LAB_LLM_MODEL=qwen2.5-coder-14b

# MUST be > 0. See docs/ANALYSIS_PLAN.md and the note in the overlay.
LAB_LLM_TEMP=0.8
